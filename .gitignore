# NASA rasters and generated materials do not belong in Git.
/data/raw/*
/data/processed/*
/exports/*
/reports/*
!/data/raw/.gitkeep
!/data/processed/.gitkeep
!/exports/.gitkeep
!/reports/.gitkeep
__pycache__/
*.py[cod]
.venv/
.env

.deps/

# Local GIS sources and large processing intermediates (exported JSON stays trackable).
*.tif
*.tiff
*.vrt
*.img
*.aux.xml
*.ovr
*.tfw
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.qix
